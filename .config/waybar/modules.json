{
  "custom/notification": {
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "none": "",
      "notification": "󰂞",
      "dnd": "󰪑",
      "dnd-none": "󰪑",
      "dnd-notification": "󰪑"
    },
    "tooltip": false,
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "on-click-middle": "swaync-client -C -sw"
  },

  "cpu": {
    "interval": 5,
    "format": "C {usage}%",
    "max-length": 5,
    "on-click": "kitty --start-as=maximized btop"
  },

  "memory": {
    "interval": 5,
    "format": "M {used}G",
    "format-alt": "M {percentage}%",
    "max-length": 10,
    "on-click": "baobab"
  },

  "custom/temp": {
    "interval": 5,
    "format": " {}°C",
    "exec": "~/.config/waybar/scripts/get_temp.sh",
    "return-type": "json",
    "tooltip": true,
  },

  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/powermenu.sh"
  },

  "custom/brightness": {
    "tooltip": true,
    "interval": 5,
    "format": "󰃠 {}%",
    "exec": "brightnessctl | grep -o '[0-9]\\{1,3\\}%'",
    "tooltip-format": "{}%",
    "on-click": "bash -c '$HOME/.config/waybar/scripts/brightness.sh'",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },

  "custom/network": {
    "exec": "~/.config/waybar/scripts/network-status.sh",
    "interval": 2,
    "tooltip": true,
    "on-click": "kitty nmtui",
    "max-length": 20
  },

  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 0%",
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%\nDevice: {desc}",

    "format-icons": {
      "bluetooth": "󰂯",
      "headphone": "",
      "headset": "",
      "speaker": "",
      "default": ""
    },

    "on-click": "kitty wiremix",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },

  "custom/caffeine": {
    "exec": "~/.config/waybar/scripts/caffeine.sh",
    "interval": 2,
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/caffeine.sh toggle"
  },

  "custom/battery": {
    "interval": 2,
    "exec": "~/.config/waybar/scripts/battery.sh",
    "return-type": "json",
    "tooltip": true,
    "on-click-right": "~/.config/waybar/scripts/battery.sh --switch"
  },

  "clock": {
    "interval": 1,
    "format": "{:%H:%M | %a %d %b}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "niri/workspaces": {
    "on-click": "activate"
  }
}
